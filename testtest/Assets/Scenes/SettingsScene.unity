    \u0437\u0434\u0435\u0441\u044C, \u0441\u0442\u0430\u043D\u0443\u0442 \u0442\u0432\u043E\u0438\u043C
    \u043A\u043E\u043C\u043F\u0430\u0441\u043E\u043C. \u041D\u0435 \u0431\u043E\u0439\u0441\u044F
    \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0442\u044C \u043D\u043E\u0432\u044B\u0435
    \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u044B \u0438 \u043F\u043E\u043C\u043D\u0438:
    \u0438\u0441\u0442\u043E\u0440\u0438\u044E \u043F\u0438\u0448\u0435\u0448\u044C
    \u0438\u043C\u0435\u043D\u043D\u043E \u0442\u044B!"
