{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(secrets/**)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Bash(rm -rf *)",
      "PowerShell(Remove-Item * -Recurse -Force*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git -C * push*)",
      "PowerShell(git push*)",
      "Bash(*deploy*)",
      "Bash(*migrate*)",
      "Bash(rm -rf*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/session-anchor.ps1",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
